{
  "name": "pilotspos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PilotsPOS — Punto de venta, inventario y caja para pequeños y medianos comercios. Producto SaaS de DevPilots.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @pilotspos/web",
    "dev:api": "npm run dev -w @pilotspos/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @pilotspos/database",
    "db:migrate": "npm run db:migrate -w @pilotspos/database",
    "db:seed": "npm run db:seed -w @pilotspos/database",
    "db:studio": "npm run db:studio -w @pilotspos/database"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "typescript-eslint": "^8.2.0",
    "drizzle-orm": "^0.45.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
