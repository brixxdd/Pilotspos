# ---
# Corte POS — Variables de entorno (desarrollo)
# Copia este archivo a .env y ajusta los valores. Nunca subas .env a Git.
# ---

# --- Base de datos ---
DATABASE_URL=postgres://pilotspos:pilotspos_dev@localhost:5432/pilotspos

# --- API (apps/api) ---
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Clave usada para firmar cookies de sesión. Genera una distinta en producción:
#   openssl rand -hex 32
COOKIE_SECRET=dev_only_change_me_dev_only_change_me

# Nombre de la cookie de sesión
SESSION_COOKIE_NAME=pilotspos_session

# Días de vigencia de la sesión
SESSION_TTL_DAYS=7

# Orígenes permitidos por CORS (separados por coma)
# apps/web-corte corre en el puerto 3100 en desarrollo.
CORS_ORIGIN=http://localhost:3100

# --- Web (apps/web-corte) ---
# URL pública de la API (usada por el proxy /api/* de Next.js)
API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Corte

# Menú digital público: número de WhatsApp del negocio que recibe los pedidos
# (código de país + número, solo dígitos). Vacío = el menú se ve pero no ofrece pedir.
MENU_WHATSAPP_NUMBER=
