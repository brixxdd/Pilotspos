# Corte POS — producción. Copiar a `.env` en /opt/corte-pos del servidor.
# NUNCA commitear el .env real.

# --- Base de datos (solo dentro de la red de Docker) ---
POSTGRES_USER=corte
POSTGRES_PASSWORD=          # openssl rand -base64 24
POSTGRES_DB=corte

# --- Sesiones ---
# Generar NUEVO, no reusar el de desarrollo:  openssl rand -hex 32
COOKIE_SECRET=
SESSION_COOKIE_NAME=pilotspos_session
CUSTOMER_COOKIE_NAME=pilotspos_customer
SESSION_TTL_DAYS=7

# --- Dominio público ---
# Se usa como CORS_ORIGIN. Con esquema y sin barra final.
PUBLIC_ORIGIN=https://corte.devpilots.dev

# --- Puerto en el host (solo 127.0.0.1, lo consume Nginx) ---
# Ocupados en el VPS: 3000 3001 3002 3005 3006 5000 5433 5678 6379 8080 8085
WEB_HOST_PORT=3007

# --- Menú digital ---
NEXT_PUBLIC_APP_NAME=Corte
# Código de país + número, solo dígitos. Vacío = el menú se ve pero no deja pedir.
MENU_WHATSAPP_NUMBER=
